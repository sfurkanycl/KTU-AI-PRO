# Bu satırları yerel .env dosyana ekle. Anahtarı sohbete yazma.
AUDIO_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Voice Library içinde seçtiğin seslerin gerçek Voice ID değerlerini yapıştır.
ELEVENLABS_CICEK_VOICE_ID=
ELEVENLABS_RYAN_VOICE_ID=
ELEVENLABS_JESSICA_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_VOICE=jessica
ELEVENLABS_MODEL=eleven_multilingual_v2
